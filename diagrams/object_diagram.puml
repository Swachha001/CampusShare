@startuml object_diagram
skinparam shadowing false
title Object Diagram: one approved request with an active transaction

object "owner : User" as owner {
  userId = 1
  fullName = "Amina Rahman"
  role = STUDENT
  status = ACTIVE
}
object "borrower : User" as borrower {
  userId = 2
  fullName = "Tanvir Hasan"
  role = STUDENT
  status = ACTIVE
}
object "calculators : ItemCategory" as cat {
  categoryId = 2
  name = "Calculators"
}
object "calculator : Item" as item {
  itemId = 1
  title = "Casio fx-991EX Calculator"
  condition = "GOOD"
  pickupLocation = "Library entrance"
  status = BORROWED
}
object "request1 : BorrowRequest" as req {
  requestId = 1
  message = "Need it for my exam week"
  status = APPROVED
}
object "transaction1 : BorrowTransaction" as txn {
  transactionId = 1
  borrowedDate = 2026-11-03
  dueDate = 2026-11-10
  returnedDate = null
  status = ACTIVE
}

owner -- item : owns
cat -- item : classifies
borrower -- req : submits
item -- req : receives
req -- txn : results in
@enduml
