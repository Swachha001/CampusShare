erDiagram
    USERS ||--o{ ITEMS : owns
    ITEM_CATEGORIES ||--o{ ITEMS : classifies
    USERS ||--o{ BORROW_REQUESTS : submits
    ITEMS ||--o{ BORROW_REQUESTS : receives
    BORROW_REQUESTS ||--o| BORROW_TRANSACTIONS : results_in
    BORROW_TRANSACTIONS ||--o{ REVIEWS : receives
    USERS ||--o{ REVIEWS : writes
    USERS ||--o{ REPORTS : files
    ITEMS ||--o{ REPORTS : subject_of

    USERS {
        bigint user_id PK
        varchar full_name
        varchar email UK
        varchar password_hash
        varchar role "STUDENT or ADMIN"
        varchar status "ACTIVE or SUSPENDED"
        datetime created_at
    }
    ITEM_CATEGORIES {
        bigint category_id PK
        varchar name UK
        varchar description
    }
    ITEMS {
        bigint item_id PK
        varchar title
        text description
        varchar item_condition "NEW, GOOD or FAIR"
        varchar pickup_location
        varchar status "AVAILABLE, BORROWED or UNAVAILABLE"
        datetime created_at
        bigint owner_id FK
        bigint category_id FK
    }
    BORROW_REQUESTS {
        bigint request_id PK
        varchar message
        date requested_start_date
        date requested_return_date
        varchar status "PENDING, APPROVED, REJECTED or CANCELLED"
        datetime requested_at
        bigint borrower_id FK
        bigint item_id FK
    }
    BORROW_TRANSACTIONS {
        bigint transaction_id PK
        date borrowed_date
        date due_date
        date returned_date
        varchar status "ACTIVE, RETURNED or OVERDUE"
        bigint request_id FK, UK
    }
    REVIEWS {
        bigint review_id PK
        int rating
        varchar comment
        datetime created_at
        bigint transaction_id FK
        bigint reviewer_id FK
    }
    REPORTS {
        bigint report_id PK
        varchar reason
        text details
        varchar status "OPEN, RESOLVED or DISMISSED"
        datetime created_at
        bigint reporter_id FK
        bigint item_id FK
    }
