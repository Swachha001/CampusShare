@startuml class_diagram
skinparam shadowing false
skinparam classAttributeIconSize 0
hide enum methods

enum Role {
  STUDENT
  ADMIN
}
enum UserStatus {
  ACTIVE
  SUSPENDED
}
enum ItemStatus {
  AVAILABLE
  BORROWED
  UNAVAILABLE
}
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
enum TransactionStatus {
  ACTIVE
  RETURNED
  OVERDUE
}
enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

class User {
  - userId : Long
  - fullName : String
  - email : String
  - passwordHash : String
  - role : Role
  - status : UserStatus
  - createdAt : LocalDateTime
  + register() : void
  + login(email, password) : boolean
  + suspend() : void
}

class ItemCategory {
  - categoryId : Long
  - name : String
  - description : String
  + rename(name) : void
}

class Item {
  - itemId : Long
  - title : String
  - description : String
  - condition : String
  - pickupLocation : String
  - status : ItemStatus
  - createdAt : LocalDateTime
  + markAvailable() : void
  + markBorrowed() : void
  + markUnavailable() : void
}

class BorrowRequest {
  - requestId : Long
  - message : String
  - requestedStartDate : LocalDate
  - requestedReturnDate : LocalDate
  - status : RequestStatus
  - requestedAt : LocalDateTime
  + approve() : BorrowTransaction
  + reject() : void
  + cancel() : void
}

class BorrowTransaction {
  - transactionId : Long
  - borrowedDate : LocalDate
  - dueDate : LocalDate
  - returnedDate : LocalDate
  - status : TransactionStatus
  + markReturned() : void
  + isOverdue() : boolean
}

class Review {
  - reviewId : Long
  - rating : int
  - comment : String
  - createdAt : LocalDateTime
}

class Report {
  - reportId : Long
  - reason : String
  - details : String
  - status : ReportStatus
  - createdAt : LocalDateTime
  + resolve() : void
  + dismiss() : void
}

User "1" -- "0..*" Item : owns
ItemCategory "1" -- "0..*" Item : classifies
User "1" -- "0..*" BorrowRequest : submits
Item "1" -- "0..*" BorrowRequest : receives
BorrowRequest "1" -- "0..1" BorrowTransaction : results in
BorrowTransaction "1" -- "0..*" Review : receives
User "1" -- "0..*" Review : writes
User "1" -- "0..*" Report : files
Item "1" -- "0..*" Report : subject of

User ..> Role
User ..> UserStatus
Item ..> ItemStatus
BorrowRequest ..> RequestStatus
BorrowTransaction ..> TransactionStatus
Report ..> ReportStatus
@enduml
